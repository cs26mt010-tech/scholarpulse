# ScholarPulse Environment Configuration (MS-3)
# Copy this file to .env before running `docker compose up --build`
# NEVER commit your actual .env file or API keys to Git!

# Application Settings
APP_NAME=ScholarPulse
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database Configuration (MySQL 8.0 for Docker Compose)
MYSQL_ROOT_PASSWORD=scholarpulse_root_secret
MYSQL_DATABASE=scholarpulse
MYSQL_USER=sp_user
MYSQL_PASSWORD=sp_password_2026
MYSQL_HOST=db
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://sp_user:sp_password_2026@db:3306/scholarpulse?charset=utf8mb4

# Security & Session Authentication
# Generate a strong secret in production: openssl rand -hex 32
SESSION_SECRET_KEY=dev_session_secret_replace_in_prod_9f8a7b6c5d4e3f2a1b0c
CSRF_SECRET_KEY=dev_csrf_secret_replace_in_prod_1a2b3c4d5e6f7a8b9c0d
SESSION_COOKIE_NAME=sp_session
SESSION_EXPIRE_HOURS=24
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Upload Constraints
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt
UPLOAD_STORAGE_DIR=/app/uploads

# Google Gemini API (Server-Side Only - Never exposed to Frontend)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=1
AI_SIMILARITY_THRESHOLD=0.35
AI_TOP_K_SINGLE=5
AI_TOP_K_MULTI=8
AI_MAX_CHUNKS_PER_RESOURCE=3
AI_MAX_COLLECTION_RESOURCES=20
AI_MAX_QUESTION_LENGTH=300
AI_RATE_LIMIT_PER_HOUR=20

# Seed Configuration
SEED_RANDOM_SEED=2026
AUTO_SEED_ON_STARTUP=true
