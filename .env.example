
# ==================================================
# ScholarPulse Environment Configuration (MS-3)
# Copy this file to .env and configure your credentials.
# NEVER commit actual secrets to GitHub.
# ==================================================

# Application Settings
APP_NAME=ScholarPulse
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database Configuration
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=scholarpulse
MYSQL_USER=sp_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_PORT_HOST=3306

DATABASE_URL=mysql+pymysql://sp_user:your_mysql_password@db:3306/scholarpulse?charset=utf8mb4

# Security & Session Authentication
SESSION_SECRET_KEY=replace_with_random_secret
CSRF_SECRET_KEY=replace_with_another_random_secret
SESSION_COOKIE_NAME=sp_session
SESSION_EXPIRE_HOURS=24
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_address
FRONTEND_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_TTL_MINUTES=15

# Password Reset
PASSWORD_RESET_TTL_MINUTES=15

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt
UPLOAD_STORAGE_DIR=/app/uploads

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.8-flash

# AI Configuration
AI_REQUEST_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=1
AI_SIMILARITY_THRESHOLD=0.18
AI_TOP_K_SINGLE=5
AI_TOP_K_MULTI=8
AI_MAX_CHUNKS_PER_RESOURCE=3
AI_MAX_COLLECTION_RESOURCES=20
AI_MAX_QUESTION_LENGTH=300
AI_RATE_LIMIT_PER_HOUR=20

# Seed Configuration
SEED_RANDOM_SEED=2026
AUTO_SEED_ON_STARTUP=true
